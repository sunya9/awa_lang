// 第一級関数・クロージャ・再帰のデモ（Scala 風: セミコロン不要）
// 注釈なしの a + b は数値型が定まらず曖昧なので、引数に型注釈を付ける。
let add = fn(a: Int, b: Int) { a + b }
add(1, 2)

// クロージャ: 返された関数が n を覚えている（n の数値型を注釈で固定）
let make_adder = fn(n: Int) { fn(x) { x + n } }
let add5 = make_adder(5)
add5(10)

// 高階関数: 関数を引数に渡す
let apply_twice = fn(f, x) { f(f(x)) }
apply_twice(add5, 0)

// 再帰と複数文ブロック
let fact = fn(n) {
  if n == 0 {
    1
  } else {
    n * fact(n - 1)
  }
}
fact(5)
