// do 記法は Future だけでなく Option/Result でも書ける。
// `v <- e` は e.flatMap(fn(v){ 残り }) に脱糖し、各型の pub impl メソッドで解決される。
import std/io
import std/option
import std/result

// Option: どれかが None なら全体が None に短絡する。
let total = do {
  a <- option.Some(10)
  b <- option.Some(20)
  c <- option.Some(12)
  option.Some(a + b + c)
}

// Result: Err は伝播。安全な割り算を do でつなぐ。
let safe_div = fn(a: Int, b: Int) -> result.Result(Int, String) {
  if b == 0 { result.Err("division by zero") } else { result.Ok(a / b) }
}
let computed = do {
  x <- safe_div(100, 5)
  y <- safe_div(x, 4)
  result.Ok(y)
}

let main = fn() {
  io.println("total   = ${option.unwrap_or(total, 0)}")        // 42
  io.println("computed= ${result.unwrap_or(computed, 0 - 1)}") // 5
}
