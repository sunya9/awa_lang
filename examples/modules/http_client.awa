// HTTP クライアント（native 専用）。GET して解析済み Response を表示する。
import std/io
import std/http
import std/result

let main = fn() {
  case run(http.get("127.0.0.1", 18080, "/hello")) {
    result.Ok(resp) -> io.println("status=${http.resp_status(resp)} body=${http.resp_body(resp)}")
    result.Err(e) -> io.println("parse error: ${e}")
  }
}
