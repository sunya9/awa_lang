// ===== 標準型 Int / Long / Float / String のデモ =====
// 数値リテラル: 1=Int、1L=Long、1.0=Float。文字列は "..."。
// 演算子は同一記号（+ - * / < ...）だが、型が違うと暗黙変換せず型エラー。

3 + 4               // 7 : Int
3L + 4L             // 7 : Long
3.0 + 0.5           // 3.5 : Float

// 文字列リテラルと連結 <>。等価 == は全型に効く。
"awa" <> " lang"    // "awa lang" : String
"x" == "x"          // true : Bool

// 数値型は混ぜられない（暗黙変換なし）。下はコメントを外すと型エラー:
//   3 + 3.0        // Int と Float は一致しません
// 変換は組込関数で明示する。
int_to_float(3) + 0.5     // 3.5 : Float
int_to_string(42)         // "42" : String

// 注釈なしの算術は数値型が定まらず曖昧 → 注釈で固定する。
let add = fn(a: Int, b: Int) { a + b }
add(10, 20)               // 30 : Int

// 文字列でパターンマッチ（無限ドメインなので catch-all 必須）。
let classify = fn(s) {
  case s {
    "" -> 0
    _ -> 1
  }
}
classify("hi")            // 末尾（統合テストで 1 を検査）
