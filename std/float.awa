// 標準ライブラリ: 浮動小数ユーティリティ。
// to_string は組込 float_to_string のラッパ（別名）。abs/max/min は純粋 awa。
pub let to_string = fn(x: Float) -> String { float_to_string(x) }

pub let abs = fn(x: Float) -> Float {
  case x < 0.0 {
    true -> -x
    false -> x
  }
}

pub let max: fn(Float, Float) -> Float = fn(a, b) {
  case a > b {
    true -> a
    false -> b
  }
}

pub let min: fn(Float, Float) -> Float = fn(a, b) {
  case a < b {
    true -> a
    false -> b
  }
}

pub let to_int = fn(x: Float) -> Int { float_to_int(x) }

// x を [lo, hi] に収める。
pub let clamp: fn(Float, Float, Float) -> Float = fn(x, lo, hi) {
  case x < lo {
    true -> lo
    false -> case x > hi {
      true -> hi
      false -> x
    }
  }
}
