// 標準ライブラリ: HTTP（client / server）。
// メッセージの組み立て/解析は純 awa（std/string の上）。実際の通信は socket 組込
// （tcp_connect/sock_read/sock_write/tcp_listen/accept）の上に載るので native ビルド専用。
// client: get/post/request（HTTP/1.1・任意メソッド・ヘッダ・ボディ、解析済み Response）。
// レスポンスは Content-Length / chunked / close 区切りを見分けて読む。ヘッダ取得は大小無視。
// server: serve_once（1 接続）/ serve（accept ループ）。Content-Length はバイト長。
// 割り切り: keep-alive 不使用（Connection: close）、UTF-8 のチャンク途中分割は未対応。
import std/list
import std/result
import std/string
import std/pair
import std/option

// メソッド・パス・ヘッダ・ボディ。
pub type Request {
  Request(String, String, list.List(pair.Pair(String, String)), String)
}

// ステータスコード・ヘッダ・ボディ。
pub type Response {
  Response(Int, list.List(pair.Pair(String, String)), String)
}

// ----- アクセサ -----
pub let req_method = fn(r: Request) -> String {
  case r {
    Request(m, _, _, _) -> m
  }
}

pub let req_path = fn(r: Request) -> String {
  case r {
    Request(_, p, _, _) -> p
  }
}

pub let req_headers = fn(r: Request) {
  case r {
    Request(_, _, h, _) -> h
  }
}

pub let req_body = fn(r: Request) -> String {
  case r {
    Request(_, _, _, b) -> b
  }
}

pub let resp_status = fn(r: Response) -> Int {
  case r {
    Response(s, _, _) -> s
  }
}

pub let resp_headers = fn(r: Response) {
  case r {
    Response(_, h, _) -> h
  }
}

pub let resp_body = fn(r: Response) -> String {
  case r {
    Response(_, _, b) -> b
  }
}

// ヘッダ 1 つ（name, value）を作る小道具。
pub let header = fn(name: String, value: String) -> pair.Pair(String, String) {
  pair.Pair(name, value)
}

// text/plain なシンプルなレスポンス。
pub let response = fn(status: Int, body: String) -> Response {
  Response(status, list.Cons(header("Content-Type", "text/plain"), list.Nil), body)
}

// ヘッダを明示して作る。
pub let response_with = fn(status: Int, headers, body: String) -> Response {
  Response(status, headers, body)
}

// ヘッダ取得（HTTP の仕様どおり名前は大文字小文字を区別しない）。
let header_find = fn(headers, lname) {
  case headers {
    list.Nil -> option.None
    list.Cons(h, t) -> case h {
      pair.Pair(k, v) -> case string.to_lower(k) == lname {
        true -> option.Some(v)
        false -> header_find(t, lname)
      }
    }
  }
}

pub let get_header = fn(headers, name: String) -> option.Option(String) {
  header_find(headers, string.to_lower(name))
}

// ----- 文字列ユーティリティ（このモジュール内）-----
// sub が最初に現れる位置（無ければ -1）。
let find_from = fn(s, sub, i, len, sublen) {
  case i + sublen > len {
    true -> -1
    false -> case string.slice(s, i, i + sublen) == sub {
      true -> i
      false -> find_from(s, sub, i + 1, len, sublen)
    }
  }
}

let find_sub = fn(s, sub) { find_from(s, sub, 0, string_length(s), string_length(sub)) }

// 行末の \r（CR）を落とす。
let strip_cr = fn(line) {
  case string.ends_with(line, "\r") {
    true -> string.slice(line, 0, string_length(line) - 1)
    false -> line
  }
}

// 先頭の半角スペースを落とす。
let ltrim = fn(s) {
  case string.starts_with(s, " ") {
    true -> ltrim(string.slice(s, 1, string_length(s)))
    false -> s
  }
}

// "Key: Value" 行を Pair へ（: が無ければ None）。
let parse_header_line = fn(line) {
  let colon = string.index_of(line, 58)
  case colon == -1 {
    true -> option.None
    false -> {
      let k = string.slice(line, 0, colon)
      let v = ltrim(string.slice(line, colon + 1, string_length(line)))
      option.Some(pair.Pair(k, v))
    }
  }
}

// ヘッダ行のリスト → Pair のリスト（空行・不正行は飛ばす）。
let parse_headers = fn(lines) {
  case lines {
    list.Nil -> list.Nil
    list.Cons(h, t) -> {
      let line = strip_cr(h)
      case string.is_empty(line) {
        true -> parse_headers(t)
        false -> case parse_header_line(line) {
          option.Some(p) -> list.Cons(p, parse_headers(t))
          option.None -> parse_headers(t)
        }
      }
    }
  }
}

// ----- chunked 転送デコード -----
let hex_digit = fn(c) {
  case c >= 48 && c <= 57 {
    true -> c - 48
    false -> case c >= 97 && c <= 102 {
      true -> c - 97 + 10
      false -> case c >= 65 && c <= 70 {
        true -> c - 65 + 10
        false -> -1
      }
    }
  }
}

let hex_loop = fn(s, i, acc) {
  let d = hex_digit(string_char_at(s, i))
  case d == -1 {
    true -> acc
    false -> hex_loop(s, i + 1, acc * 16 + d)
  }
}

// チャンクサイズ行（16進、; 拡張は無視）→ サイズ。
let parse_hex = fn(s) { hex_loop(s, 0, 0) }

// 位置 i から \n のインデックス（無ければ末尾）。
let next_nl = fn(s, i) {
  let c = string_char_at(s, i)
  case c == 10 {
    true -> i
    false -> case c == -1 {
      true -> i
      false -> next_nl(s, i + 1)
    }
  }
}

// chunked ボディをデコード。i は次のサイズ行の先頭。サイズはバイト単位（ASCII 前提）。
let dechunk_from = fn(s, i, acc) {
  let nl = next_nl(s, i)
  let size = parse_hex(strip_cr(string.slice(s, i, nl)))
  case size == 0 {
    true -> acc
    false -> {
      let data = nl + 1
      dechunk_from(s, data + size + 2, acc <> string.slice(s, data, data + size))
    }
  }
}

// Transfer-Encoding: chunked のボディを連結された生データへ。
pub let dechunk = fn(s: String) -> String { dechunk_from(s, 0, "") }

// ----- 解析 -----
// 生のレスポンス文字列 → Response（chunked なら自動デコード）。
pub let parse_response = fn(raw: String) -> result.Result(Response, String) {
  let b = find_sub(raw, "\r\n\r\n")
  case b == -1 {
    true -> result.Err("no header/body boundary")
    false -> {
      let head = string.slice(raw, 0, b)
      let body = string.slice(raw, b + 4, string_length(raw))
      case string.split(head, 10) {
        list.Nil -> result.Err("empty response")
        list.Cons(statusline, rest) -> {
          let code = case string.split(strip_cr(statusline), 32) {
            list.Cons(_, list.Cons(codestr, _)) -> string.to_int(codestr)
            _ -> 0
          }
          let headers = parse_headers(rest)
          // Transfer-Encoding: chunked ならボディをデコードする。
          let final_body = case get_header(headers, "transfer-encoding") {
            option.Some(te) -> case string.to_lower(te) == "chunked" {
              true -> dechunk(body)
              false -> body
            }
            option.None -> body
          }
          result.Ok(Response(code, headers, final_body))
        }
      }
    }
  }
}

// 生のリクエスト文字列 → Request。
pub let parse_request = fn(raw: String) -> result.Result(Request, String) {
  let b = find_sub(raw, "\r\n\r\n")
  let bound = case b == -1 {
    true -> string_length(raw)
    false -> b
  }
  let head = string.slice(raw, 0, bound)
  let body = case b == -1 {
    true -> ""
    false -> string.slice(raw, b + 4, string_length(raw))
  }
  case string.split(head, 10) {
    list.Nil -> result.Err("empty request")
    list.Cons(reqline, rest) -> {
      case string.split(strip_cr(reqline), 32) {
        list.Cons(method, list.Cons(path, _)) -> result.Ok(
          Request(method, path, parse_headers(rest), body)
        )
        _ -> result.Err("bad request line")
      }
    }
  }
}

// ----- 組み立て -----
// ステータスコード → 理由句。
pub let reason = fn(status: Int) -> String {
  case status == 200 {
    true -> "OK"
    false -> case status == 201 {
      true -> "Created"
      false -> case status == 204 {
        true -> "No Content"
        false -> case status == 301 {
          true -> "Moved Permanently"
          false -> case status == 302 {
            true -> "Found"
            false -> case status == 400 {
              true -> "Bad Request"
              false -> case status == 401 {
                true -> "Unauthorized"
                false -> case status == 403 {
                  true -> "Forbidden"
                  false -> case status == 404 {
                    true -> "Not Found"
                    false -> case status == 405 {
                      true -> "Method Not Allowed"
                      false -> case status == 500 {
                        true -> "Internal Server Error"
                        false -> "OK"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

let headers_to_string = fn(headers) {
  case headers {
    list.Nil -> ""
    list.Cons(h, t) -> case h {
      pair.Pair(k, v) -> k <> ": " <> v <> "\r\n" <> headers_to_string(t)
    }
  }
}

// Response → 生の文字列（Content-Length をバイト長で自動付与）。
pub let response_to_string = fn(resp: Response) -> String {
  case resp {
    Response(status, headers, body) -> {
      let line = "HTTP/1.0 " <> int_to_string(status) <> " " <> reason(status) <> "\r\n"
      let clen = "Content-Length: " <> int_to_string(string.byte_length(body)) <> "\r\n"
      line <> headers_to_string(headers) <> clen <> "\r\n" <> body
    }
  }
}

// 任意メソッド・ヘッダ・ボディの生リクエスト（Connection: close）。
pub let build_request = fn(method: String, host: String, path: String, headers, body: String) -> String {
  let line = method <> " " <> path <> " HTTP/1.1\r\n"
  let host_h = "Host: " <> host <> "\r\n"
  let clen = "Content-Length: " <> int_to_string(string.byte_length(body)) <> "\r\n"
  line <> host_h <> headers_to_string(headers) <> clen <> "Connection: close\r\n\r\n" <> body
}

// GET の生リクエスト（後方互換）。
pub let get_request = fn(host: String, path: String) -> String {
  build_request("GET", host, path, list.Nil, "")
}

// ----- 通信（native ビルド専用）-----
// 接続が閉じる（空読み）まで読み切る。
let read_all = fn(sock, acc) -> Future(String) {
  do {
    chunk <- sock_read(sock)
    case string.is_empty(chunk) {
      true -> pure(acc)
      false -> read_all(sock, acc <> chunk)
    }
  }
}

// ヘッダ境界 \r\n\r\n が現れるまで読む（EOF なら不完全のまま返す）。
let read_headers = fn(sock, acc) -> Future(String) {
  case find_sub(acc, "\r\n\r\n") >= 0 {
    true -> pure(acc)

    false -> do {
      chunk <- sock_read(sock)
      case string.is_empty(chunk) {
        true -> pure(acc)
        false -> read_headers(sock, acc <> chunk)
      }
    }
  }
}

// 累計バイト数が need 以上になるまで読む（Content-Length 用）。
let read_n = fn(sock, acc, need) -> Future(String) {
  case string.byte_length(acc) >= need {
    true -> pure(acc)

    false -> do {
      chunk <- sock_read(sock)
      case string.is_empty(chunk) {
        true -> pure(acc)
        false -> read_n(sock, acc <> chunk, need)
      }
    }
  }
}

// chunked 終端（0 サイズチャンク 0\r\n\r\n）が現れるまで読む。
let read_chunked = fn(sock, acc) -> Future(String) {
  case find_sub(acc, "0\r\n\r\n") >= 0 {
    true -> pure(acc)

    false -> do {
      chunk <- sock_read(sock)
      case string.is_empty(chunk) {
        true -> pure(acc)
        false -> read_chunked(sock, acc <> chunk)
      }
    }
  }
}

// レスポンスをフレーミングに従って読み切る: chunked / Content-Length / close 区切り。
let read_response = fn(sock) -> Future(String) {
  do {
    raw <- read_headers(sock, "")
    let b = find_sub(raw, "\r\n\r\n")
    case b == -1 {
      true -> pure(raw)
      false -> {
        let hdrs = case string.split(string.slice(raw, 0, b), 10) {
          list.Cons(_, rest) -> parse_headers(rest)
          list.Nil -> list.Nil
        }
        case get_header(hdrs, "transfer-encoding") {
          option.Some(_) -> read_chunked(sock, raw)
          option.None -> case get_header(hdrs, "content-length") {
            option.Some(cl) -> read_n(sock, raw, b + 4 + string.to_int(cl))
            option.None -> read_all(sock, raw)
          }
        }
      }
    }
  }
}

// 生リクエスト文字列を送り、レスポンス全体を読んで返す（フレーミング対応・低レベル）。
pub let send_raw = fn(host: String, port: Int, raw: String) -> Future(String) {
  do {
    sock <- tcp_connect(host, port)
    sock_write(sock, raw)
    body <- read_response(sock)
    let _ = sock_close(sock)
    pure(body)
  }
}

// host:port:path に GET して生レスポンス文字列を返す（後方互換・低レベル）。
pub let fetch = fn(host: String, port: Int, path: String) -> Future(String) {
  send_raw(host, port, get_request(host, path))
}

// 任意メソッドで要求し、解析済み Response を返す（解析失敗は Err）。
pub let request = fn(method: String, host: String, port: Int, path: String, headers, body: String) -> Future(result.Result(Response, String)) {
  do {
    raw <- send_raw(host, port, build_request(method, host, path, headers, body))
    pure(parse_response(raw))
  }
}

// GET / POST のショートカット（解析済み Response を返す）。
pub let get = fn(host: String, port: Int, path: String) -> Future(result.Result(Response, String)) {
  request("GET", host, port, path, list.Nil, "")
}

pub let post = fn(host: String, port: Int, path: String, body: String) -> Future(result.Result(Response, String)) {
  request("POST", host, port, path, list.Nil, body)
}

// 1 接続を受けて handler で応答する（server は listen 済みソケット）。
pub let serve_once = fn(server, handler) -> Future(Int) {
  do {
    client <- accept(server)
    raw <- sock_read(client)
    let resp = case parse_request(raw) {
      result.Ok(req) -> handler(req)
      result.Err(e) -> response(400, "bad request: " <> e)
    }
    sock_write(client, response_to_string(resp))
    let _ = sock_close(client)
    pure(0)
  }
}

// 接続を受け続けるサーバ（1 接続ごとに serve_once、終わったら再帰でまた accept）。
// 末尾再帰なので定数スタックで回り続ける。
pub let serve = fn(server, handler) -> Future(Int) {
  do {
    serve_once(server, handler)
    serve(server, handler)
  }
}
