// 標準ライブラリ: 最小 HTTP（client / server）。
// メッセージの組み立て/解析は純 awa（std/string の上）。実際の通信は socket 組込
// （tcp_connect/sock_read/sock_write/tcp_listen/accept）の上に載るので native ビルド専用。
// 既知の割り切り: HTTP/1.0・Connection: close 前提、ヘッダ名は完全一致（大小無視しない）、
// chunked 転送や \uXXXX などは未対応。学習用の最小実装。
import std/list
import std/result
import std/string
import std/pair
import std/option

// メソッド・パス・ヘッダ・ボディ。
pub type Request {
  Request(String, String, list.List(pair.Pair(String, String)), String)
}

// ステータスコード・ヘッダ・ボディ。
pub type Response {
  Response(Int, list.List(pair.Pair(String, String)), String)
}

// ----- アクセサ -----
pub let req_method = fn(r: Request) -> String {
  case r {
    Request(m, _, _, _) -> m
  }
}

pub let req_path = fn(r: Request) -> String {
  case r {
    Request(_, p, _, _) -> p
  }
}

pub let req_headers = fn(r: Request) {
  case r {
    Request(_, _, h, _) -> h
  }
}

pub let req_body = fn(r: Request) -> String {
  case r {
    Request(_, _, _, b) -> b
  }
}

pub let resp_status = fn(r: Response) -> Int {
  case r {
    Response(s, _, _) -> s
  }
}

pub let resp_headers = fn(r: Response) {
  case r {
    Response(_, h, _) -> h
  }
}

pub let resp_body = fn(r: Response) -> String {
  case r {
    Response(_, _, b) -> b
  }
}

// text/plain なシンプルなレスポンス。
pub let response = fn(status: Int, body: String) -> Response {
  Response(status, list.Cons(pair.Pair("Content-Type", "text/plain"), list.Nil), body)
}

// ヘッダ取得（完全一致）。
let header_find = fn(headers, name) {
  case headers {
    list.Nil -> option.None
    list.Cons(h, t) -> case h {
      pair.Pair(k, v) -> case k == name {
        true -> option.Some(v)
        false -> header_find(t, name)
      }
    }
  }
}

pub let get_header = fn(headers, name: String) -> option.Option(String) {
  header_find(headers, name)
}

// ----- 文字列ユーティリティ（このモジュール内）-----
// sub が最初に現れる位置（無ければ -1）。
let find_from = fn(s, sub, i, len, sublen) {
  case i + sublen > len {
    true -> -1
    false -> case string.slice(s, i, i + sublen) == sub {
      true -> i
      false -> find_from(s, sub, i + 1, len, sublen)
    }
  }
}

let find_sub = fn(s, sub) { find_from(s, sub, 0, string_length(s), string_length(sub)) }

// 行末の \r（CR）を落とす。
let strip_cr = fn(line) {
  case string.ends_with(line, "\r") {
    true -> string.slice(line, 0, string_length(line) - 1)
    false -> line
  }
}

// 先頭の半角スペースを落とす。
let ltrim = fn(s) {
  case string.starts_with(s, " ") {
    true -> ltrim(string.slice(s, 1, string_length(s)))
    false -> s
  }
}

// "Key: Value" 行を Pair へ（: が無ければ None）。
let parse_header_line = fn(line) {
  let colon = string.index_of(line, 58)
  case colon == -1 {
    true -> option.None
    false -> {
      let k = string.slice(line, 0, colon)
      let v = ltrim(string.slice(line, colon + 1, string_length(line)))
      option.Some(pair.Pair(k, v))
    }
  }
}

// ヘッダ行のリスト → Pair のリスト（空行・不正行は飛ばす）。
let parse_headers = fn(lines) {
  case lines {
    list.Nil -> list.Nil
    list.Cons(h, t) -> {
      let line = strip_cr(h)
      case string.is_empty(line) {
        true -> parse_headers(t)
        false -> case parse_header_line(line) {
          option.Some(p) -> list.Cons(p, parse_headers(t))
          option.None -> parse_headers(t)
        }
      }
    }
  }
}

// ----- 解析 -----
// 生のレスポンス文字列 → Response。
pub let parse_response = fn(raw: String) -> result.Result(Response, String) {
  let b = find_sub(raw, "\r\n\r\n")
  case b == -1 {
    true -> result.Err("no header/body boundary")
    false -> {
      let head = string.slice(raw, 0, b)
      let body = string.slice(raw, b + 4, string_length(raw))
      case string.split(head, 10) {
        list.Nil -> result.Err("empty response")
        list.Cons(statusline, rest) -> {
          let code = case string.split(strip_cr(statusline), 32) {
            list.Cons(_, list.Cons(codestr, _)) -> string.to_int(codestr)
            _ -> 0
          }
          result.Ok(Response(code, parse_headers(rest), body))
        }
      }
    }
  }
}

// 生のリクエスト文字列 → Request。
pub let parse_request = fn(raw: String) -> result.Result(Request, String) {
  let b = find_sub(raw, "\r\n\r\n")
  let bound = case b == -1 {
    true -> string_length(raw)
    false -> b
  }
  let head = string.slice(raw, 0, bound)
  let body = case b == -1 {
    true -> ""
    false -> string.slice(raw, b + 4, string_length(raw))
  }
  case string.split(head, 10) {
    list.Nil -> result.Err("empty request")
    list.Cons(reqline, rest) -> {
      case string.split(strip_cr(reqline), 32) {
        list.Cons(method, list.Cons(path, _)) -> result.Ok(
          Request(method, path, parse_headers(rest), body)
        )
        _ -> result.Err("bad request line")
      }
    }
  }
}

// ----- 組み立て -----
let reason = fn(status) {
  case status == 200 {
    true -> "OK"
    false -> case status == 404 {
      true -> "Not Found"
      false -> case status == 400 {
        true -> "Bad Request"
        false -> "OK"
      }
    }
  }
}

let headers_to_string = fn(headers) {
  case headers {
    list.Nil -> ""
    list.Cons(h, t) -> case h {
      pair.Pair(k, v) -> k <> ": " <> v <> "\r\n" <> headers_to_string(t)
    }
  }
}

// Response → 生の文字列（Content-Length を自動付与）。
pub let response_to_string = fn(resp: Response) -> String {
  case resp {
    Response(status, headers, body) -> {
      let line = "HTTP/1.0 " <> int_to_string(status) <> " " <> reason(status) <> "\r\n"
      let clen = "Content-Length: " <> int_to_string(string_length(body)) <> "\r\n"
      line <> headers_to_string(headers) <> clen <> "\r\n" <> body
    }
  }
}

// GET の生リクエスト（Connection: close）。
pub let get_request = fn(host: String, path: String) -> String {
  "GET " <> path <> " HTTP/1.0\r\nHost: " <> host <> "\r\nConnection: close\r\n\r\n"
}

// ----- 通信（native ビルド専用）-----
// 接続が閉じる（空読み）まで読み切る。
let read_all = fn(sock, acc) -> Future(String) {
  do {
    chunk <- sock_read(sock)
    case string.is_empty(chunk) {
      true -> pure(acc)
      false -> read_all(sock, acc <> chunk)
    }
  }
}

// host:port:path に GET して生レスポンス文字列を返す（parse_response で解析できる）。
pub let fetch = fn(host: String, port: Int, path: String) -> Future(String) {
  do {
    sock <- tcp_connect(host, port)
    sock_write(sock, get_request(host, path))
    body <- read_all(sock, "")
    let _ = sock_close(sock)
    pure(body)
  }
}

// 1 接続だけ受けて handler で応答するサーバ。server は listen 済みソケット。
pub let serve_once = fn(server, handler) -> Future(Int) {
  do {
    client <- accept(server)
    raw <- sock_read(client)
    let resp = case parse_request(raw) {
      result.Ok(req) -> handler(req)
      result.Err(e) -> response(400, "bad request: " <> e)
    }
    sock_write(client, response_to_string(resp))
    let _ = sock_close(client)
    pure(0)
  }
}
