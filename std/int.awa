// 標準ライブラリ: 整数ユーティリティ。
// to_string は組込 int_to_string のラッパ（別名にして自己再帰を回避）。abs/max/min は純粋 awa。
pub let to_string = fn(n: Int) -> String { int_to_string(n) }

pub let abs = fn(n: Int) -> Int {
  case n < 0 {
    true -> -n
    false -> n
  }
}

pub let max: fn(Int, Int) -> Int = fn(a, b) {
  case a > b {
    true -> a
    false -> b
  }
}

pub let min: fn(Int, Int) -> Int = fn(a, b) {
  case a < b {
    true -> a
    false -> b
  }
}

// n を [lo, hi] に収める。
pub let clamp: fn(Int, Int, Int) -> Int = fn(n, lo, hi) {
  case n < lo {
    true -> lo
    false -> case n > hi {
      true -> hi
      false -> n
    }
  }
}

// 累乗（exp < 0 は 0）。
pub let pow: fn(Int, Int) -> Int = fn(base, exp) {
  case exp <= 0 {
    true -> case exp == 0 {
      true -> 1
      false -> 0
    }
    false -> base * pow(base, exp - 1)
  }
}

pub let is_even = fn(n: Int) -> Bool { n - n / 2 * 2 == 0 }

pub let is_odd = fn(n: Int) -> Bool { n - n / 2 * 2 != 0 }

// 符号（負 -1 / 零 0 / 正 1）。
pub let sign: fn(Int) -> Int = fn(n) {
  case n < 0 {
    true -> -1
    false -> case n > 0 {
      true -> 1
      false -> 0
    }
  }
}

pub let to_float = fn(n: Int) -> Float { int_to_float(n) }
