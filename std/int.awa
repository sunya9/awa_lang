// 標準ライブラリ: 整数ユーティリティ。
// to_string は組込 int_to_string のラッパ（別名にして自己再帰を回避）。abs/max/min は純粋 awa。
pub let to_string = fn(n: Int) -> String { int_to_string(n) }

pub let abs = fn(n: Int) -> Int {
  case n < 0 {
    true -> -n
    false -> n
  }
}

pub let max: fn(Int, Int) -> Int = fn(a, b) {
  case a > b {
    true -> a
    false -> b
  }
}

pub let min: fn(Int, Int) -> Int = fn(a, b) {
  case a < b {
    true -> a
    false -> b
  }
}
