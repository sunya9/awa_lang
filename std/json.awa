// 標準ライブラリ: JSON。値は ADT で表現し、パーサ/シリアライザは純 awa で書く。
// 土台: 文字列プリミティブ（string_char_at/char_to_string/string_to_float）と std/string。
//
// awa は相互再帰を持たないので、値↔配列↔オブジェクトの相互再帰は
// 「値パーサ自身を高階引数 pv として要素ループに渡す」ことで自己再帰だけで表現する。
// 同様に stringify は list.map に自分自身を渡して入れ子をたどる。
import std/list
import std/result
import std/string
import std/pair

// JSON 値。数値は JSON 仕様どおりすべて Float。
// オブジェクト要素は共有の pair.Pair（pub なので利用側で分解できる）。
pub type Json {
  JNull
  JBool(Bool)
  JNum(Float)
  JStr(String)
  JArr(list.List(Json))
  JObj(list.List(pair.Pair(String, Json)))
}

// パーサの途中状態: 値と次の位置。
type Parsed(a) {
  Parsed(a, Int)
}

// ===== パーサ =====
// 空白（スペース/タブ/改行/復帰）を読み飛ばし、次の位置を返す。
let skip_ws = fn(s, i) {
  let c = string_char_at(s, i)
  case c == 32 {
    true -> skip_ws(s, i + 1)
    false -> case c == 10 {
      true -> skip_ws(s, i + 1)
      false -> case c == 9 {
        true -> skip_ws(s, i + 1)
        false -> case c == 13 {
          true -> skip_ws(s, i + 1)
          false -> i
        }
      }
    }
  }
}

// "..." の中身を 1 文字ずつ読む（エスケープ対応・\uXXXX は未対応）。i は開きクォートの次。
let scan_string = fn(s, i, acc) {
  let c = string_char_at(s, i)
  case c == -1 {
    true -> result.Err("unterminated string")
    false -> case c == 34 {
      true -> result.Ok(Parsed(acc, i + 1))
      false -> case c == 92 {
        true -> {
          let e = string_char_at(s, i + 1)
          let ch = case e == 110 {
            true -> char_to_string(10)
            false -> case e == 116 {
              true -> char_to_string(9)
              false -> case e == 114 {
                true -> char_to_string(13)
                false -> case e == 34 {
                  true -> char_to_string(34)
                  false -> case e == 92 {
                    true -> char_to_string(92)
                    false -> char_to_string(e)
                  }
                }
              }
            }
          }
          scan_string(s, i + 2, acc <> ch)
        }
        false -> scan_string(s, i + 1, acc <> char_to_string(c))
      }
    }
  }
}

// i は開きクォート。文字列を読んで Parsed(String) を返す。
let parse_string_raw = fn(s, i) {
  case string_char_at(s, i) == 34 {
    true -> scan_string(s, i + 1, "")
    false -> result.Err("expected string")
  }
}

// 数値トークンの終端位置（[0-9 - + . e E] が続く限り）。
let num_end = fn(s, i) {
  let c = string_char_at(s, i)
  let ok = case c == 45 {
    true -> true
    false -> case c == 43 {
      true -> true
      false -> case c == 46 {
        true -> true
        false -> case c == 101 {
          true -> true
          false -> case c == 69 {
            true -> true
            false -> case c >= 48 {
              true -> c <= 57
              false -> false
            }
          }
        }
      }
    }
  }
  case ok {
    true -> num_end(s, i + 1)
    false -> i
  }
}

let parse_number = fn(s, i) {
  let e = num_end(s, i)
  case e == i {
    true -> result.Err("invalid number")
    false -> result.Ok(Parsed(JNum(string_to_float(string.slice(s, i, e))), e))
  }
}

// word（"true"/"false"/"null"）に一致すれば val を返す。
let parse_lit = fn(s, i, word, val) {
  let wl = string_length(word)
  case string.slice(s, i, i + wl) == word {
    true -> result.Ok(Parsed(val, i + wl))
    false -> result.Err("invalid literal")
  }
}

// 配列要素ループ。pv = 値パーサ（parse_value 自身を受け取る＝相互再帰の回避）。
// acc は逆順に積む（呼び元が reverse する）。i は要素 or ']' の位置。
let parse_elems = fn(s, i, acc, pv) {
  let j = skip_ws(s, i)
  case string_char_at(s, j) == 93 {
    true -> result.Ok(Parsed(acc, j + 1))
    false -> case pv(s, j) {
      result.Err(e) -> result.Err(e)
      result.Ok(Parsed(v, k)) -> {
        let m = skip_ws(s, k)
        let cc = string_char_at(s, m)
        case cc == 44 {
          true -> parse_elems(s, m + 1, list.Cons(v, acc), pv)
          false -> case cc == 93 {
            true -> result.Ok(Parsed(list.Cons(v, acc), m + 1))
            false -> result.Err("expected , or ] in array")
          }
        }
      }
    }
  }
}

// オブジェクトメンバループ。pv = 値パーサ。i は "key" or '}' の位置。
let parse_members = fn(s, i, acc, pv) {
  let j = skip_ws(s, i)
  case string_char_at(s, j) == 125 {
    true -> result.Ok(Parsed(acc, j + 1))
    false -> case parse_string_raw(s, j) {
      result.Err(e) -> result.Err(e)
      result.Ok(Parsed(key, k)) -> {
        let colon = skip_ws(s, k)
        case string_char_at(s, colon) == 58 {
          true -> case pv(s, colon + 1) {
            result.Err(e) -> result.Err(e)
            result.Ok(Parsed(v, m)) -> {
              let n = skip_ws(s, m)
              let cc = string_char_at(s, n)
              case cc == 44 {
                true -> parse_members(s, n + 1, list.Cons(pair.Pair(key, v), acc), pv)
                false -> case cc == 125 {
                  true -> result.Ok(Parsed(list.Cons(pair.Pair(key, v), acc), n + 1))
                  false -> result.Err("expected , or } in object")
                }
              }
            }
          }
          false -> result.Err("expected : in object")
        }
      }
    }
  }
}

// 1 つの JSON 値をパース。配列/オブジェクトは自分自身を pv として渡す（自己再帰）。
let parse_value = fn(s, i) {
  let j = skip_ws(s, i)
  let c = string_char_at(s, j)
  case c == 34 {
    true -> case parse_string_raw(s, j) {
      result.Err(e) -> result.Err(e)
      result.Ok(Parsed(str, k)) -> result.Ok(Parsed(JStr(str), k))
    }
    false -> case c == 123 {
      true -> case parse_members(s, j + 1, list.Nil, parse_value) {
        result.Err(e) -> result.Err(e)
        result.Ok(Parsed(fields, k)) -> result.Ok(Parsed(JObj(list.reverse(fields)), k))
      }
      false -> case c == 91 {
        true -> case parse_elems(s, j + 1, list.Nil, parse_value) {
          result.Err(e) -> result.Err(e)
          result.Ok(Parsed(items, k)) -> result.Ok(Parsed(JArr(list.reverse(items)), k))
        }
        false -> case c == 116 {
          true -> parse_lit(s, j, "true", JBool(true))
          false -> case c == 102 {
            true -> parse_lit(s, j, "false", JBool(false))
            false -> case c == 110 {
              true -> parse_lit(s, j, "null", JNull)
              false -> parse_number(s, j)
            }
          }
        }
      }
    }
  }
}

// 文字列を JSON へパース。末尾の余りは無視する（v1 の割り切り）。
pub let parse = fn(input: String) -> result.Result(Json, String) {
  case parse_value(input, 0) {
    result.Err(e) -> result.Err(e)
    result.Ok(Parsed(j, _)) -> result.Ok(j)
  }
}

// ===== シリアライザ =====
// JSON 文字列値のエスケープ（" \ 改行 タブ 復帰。最小限）。
let escape_at = fn(s, i, len) {
  case i >= len {
    true -> ""
    false -> {
      let c = string_char_at(s, i)
      let piece = case c == 34 {
        true -> "\\\""
        false -> case c == 92 {
          true -> "\\\\"
          false -> case c == 10 {
            true -> "\\n"
            false -> case c == 9 {
              true -> "\\t"
              false -> case c == 13 {
                true -> "\\r"
                false -> char_to_string(c)
              }
            }
          }
        }
      }
      piece <> escape_at(s, i + 1, len)
    }
  }
}

let escape_str = fn(s) { "\"" <> escape_at(s, 0, string_length(s)) <> "\"" }

// Json 値を文字列へ。入れ子は list.map に stringify 自身を渡してたどる（自己再帰）。
pub let stringify = fn(j: Json) -> String {
  case j {
    JNull -> "null"
    JBool(b) -> case b {
      true -> "true"
      false -> "false"
    }
    JNum(n) -> float_to_string(n)
    JStr(s) -> escape_str(s)
    JArr(items) -> {
      let parts = list.map(items, fn(x) { stringify(x) })
      "[" <> string.join(parts, ",") <> "]"
    }
    JObj(fields) -> {
      let parts = list.map(
        fields,
        fn(p) {
          case p {
            pair.Pair(k, v) -> escape_str(k) <> ":" <> stringify(v)
          }
        }
      )
      "{" <> string.join(parts, ",") <> "}"
    }
  }
}
