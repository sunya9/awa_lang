// 標準ライブラリ: Option（値があるかもしれない）。純粋に awa で書ける＝組込でなく stdlib。
// （option → result の一方向 import。result→option の相互参照を避け循環 import を防ぐため、
// Option↔Result の変換は両方この option 側に置く。）
import std/result

pub type Option(a) {
  Some(a)
  None
}

// ----- 関数版（qualified `option.map(o, f)` / pipe 向き）-----
// 中身に関数を適用する（None はそのまま）。
pub let map: fn(Option(a), fn(a) -> b) -> Option(b) = fn(o, f) {
  case o {
    Some(x) -> Some(f(x))
    None -> None
  }
}

// 中身、無ければ既定値。
pub let unwrap_or: fn(Option(a), a) -> a = fn(o, default) {
  case o {
    Some(x) -> x
    None -> default
  }
}

// ----- メソッド版（receiver.method 形式・do 記法対応）-----
// pub impl で他モジュールへ公開する。method 解決はレシーバの具体型 Option で行われる。
pub impl Option(a) {
  // do 記法のための束縛。Some なら f を適用、None は短絡（None のまま）。
  // flatMap : fn(Option(a), fn(a) -> Option(b)) -> Option(b)
  fn flatMap(self, f) {
    case self {
      Some(x) -> f(x)
      None -> None
    }
  }
  // 中身に関数を適用（None はそのまま）。
  fn map(self, f) {
    case self {
      Some(x) -> Some(f(x))
      None -> None
    }
  }
  // 中身、無ければ既定値。
  fn unwrap_or(self, default) {
    case self {
      Some(x) -> x
      None -> default
    }
  }
}

// ----- 追加コンビネータ -----
pub let is_some = fn(o: Option(a)) -> Bool {
  case o {
    Some(_) -> true
    None -> false
  }
}

pub let is_none = fn(o: Option(a)) -> Bool {
  case o {
    Some(_) -> false
    None -> true
  }
}

// Some ならそれ、None なら alt（先に来た Some）。
pub let or = fn(o, alt) {
  case o {
    Some(_) -> o
    None -> alt
  }
}

// 遅延版: None のときだけ f() を評価。f : fn() -> Option。
pub let or_else = fn(o, f) {
  case o {
    Some(_) -> o
    None -> f()
  }
}

// 述語を満たさなければ None に。
pub let filter = fn(o, pred) {
  case o {
    Some(x) -> case pred(x) {
      true -> Some(x)
      false -> None
    }
    None -> None
  }
}

// Option(Option(a)) -> Option(a)。
pub let flatten = fn(oo) {
  case oo {
    Some(o) -> o
    None -> None
  }
}

// None のとき f() を既定値に（遅延）。f : fn() -> a。
pub let unwrap_or_else = fn(o, f) {
  case o {
    Some(x) -> x
    None -> f()
  }
}

// Result へ。None は Err(err)。
pub let to_result = fn(o, err) {
  case o {
    Some(x) -> result.Ok(x)
    None -> result.Err(err)
  }
}

// Result から。Err は None。
pub let from_result = fn(r) {
  case r {
    result.Ok(x) -> Some(x)
    result.Err(_) -> None
  }
}
